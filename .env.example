# Copia este archivo a .env (NO lo subas a Git)
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=5
# Opcional. Con el contenedor mailpit los códigos quedan en http://localhost:8025
# Para correo real configura un SMTP autenticado con STARTTLS:
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@saludcita.local
# Opcional: clave alternativa al volumen Docker privado (mínimo 32 caracteres aleatorios)
APP_KEY=
